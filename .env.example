# Avatar Gatewayのローカル接続先を安全に共有するための設定例です。
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=ここにHermesのAPI_SERVER_KEYと同じ値を設定
HERMES_MODEL=hermes-agent
# 会話に使う現地時刻の基準です。変更後はバックエンドを再起動してください。
AVATAR_GATEWAY_TIMEZONE=Asia/Tokyo
# Hermesのimage_generateが生成画像を置くサーバー内ディレクトリです。
HERMES_IMAGE_CACHE_DIR=~/.hermes/cache/images

# 最初はテキスト会話だけで起動し、音声を使うときにtrueへ変更します。
STYLEBERTVITS2_ENABLED=false
STYLEBERTVITS2_SERVER_URL=http://127.0.0.1:5000
STYLEBERTVITS2_API_KEY=
STYLEBERTVITS2_MODEL_ID=0
STYLEBERTVITS2_STYLE=Neutral
STYLEBERTVITS2_SDP_RATIO=0.2
STYLEBERTVITS2_LENGTH=1.0
STYLEBERTVITS2_CHUNK_MIN_CHARS=6
STYLEBERTVITS2_CHUNK_MAX_CHARS=100

# 音声入力を使うときにtrueへ変更します。既定では追加モデルを必要としません。
FASTER_WHISPER_ENABLED=false
# 音声認識を有効にした場合も、GPUのVRAMを使わずCPUのINT8演算で実行します。
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_LANGUAGE=ja
FASTER_WHISPER_CPU_THREADS=8
FASTER_WHISPER_BEAM_SIZE=3
# モデルは導入コマンドで取得し、通常起動中の外部取得は禁止します。
FASTER_WHISPER_LOCAL_FILES_ONLY=true
FASTER_WHISPER_MAX_AUDIO_BYTES=16777216

AVATAR_GATEWAY_HOST=127.0.0.1
AVATAR_GATEWAY_PORT=8000
# LAN公開する場合だけtrueにし、接続に使うIPまたはホスト名を必ず設定します。
# Basic認証が必要な場合だけAUTH_PASSWORDへ16文字以上の値を設定します。空なら認証なしです。
AVATAR_GATEWAY_LAN_MODE=false
AVATAR_GATEWAY_AUTH_USERNAME=avatar
AVATAR_GATEWAY_AUTH_PASSWORD=
AVATAR_GATEWAY_ALLOWED_HOSTS=127.0.0.1,localhost
AVATAR_GATEWAY_IMAGE_RETENTION_DAYS=90
AVATAR_VRM_FILE=はむ子.vrm
